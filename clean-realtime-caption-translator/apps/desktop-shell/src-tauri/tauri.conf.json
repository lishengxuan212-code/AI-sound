{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Sound Realtime Translator",
  "version": "0.1.0",
  "identifier": "com.ai-sound.clean-realtime-caption-translator",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Sound Realtime Translator",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
