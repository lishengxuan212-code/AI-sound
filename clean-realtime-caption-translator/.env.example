# Local ASR
LOCAL_ASR_PROVIDER=vosk
LOCAL_ASR_WS_URL=ws://127.0.0.1:8765/ws
LOCAL_ASR_MODEL_DIR=E:\Aimod\models\vosk-model-small-en-us-0.15

# Audio devices
# Leave empty to use Windows default devices. Values should match names shown in Settings.
SYSTEM_AUDIO_OUTPUT_DEVICE=
MIC_AUDIO_INPUT_DEVICE=

# Local Translation
LOCAL_TRANSLATION_PROVIDER=dashscope_openai
LOCAL_TRANSLATION_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LOCAL_TRANSLATION_API_KEY=
LOCAL_TRANSLATION_MODEL_PATH=
LOCAL_TRANSLATION_MODEL_NAME=
LOCAL_TRANSLATION_MODEL_PATH_EN_ZH=
LOCAL_TRANSLATION_MODEL_NAME_EN_ZH=
LOCAL_TRANSLATION_MODEL_PATH_ZH_EN=
LOCAL_TRANSLATION_MODEL_NAME_ZH_EN=
LOCAL_TRANSLATION_SOURCE_LANG=en
LOCAL_TRANSLATION_TARGET_LANG=zh

# Qwen TTS
GAME_TTS_API_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
GAME_TTS_API_KEY=
DASHSCOPE_API_KEY=
GAME_TTS_API_MODEL=qwen-qwen-tts-latest
GAME_TTS_API_VOICE=
GAME_TTS_API_FORMAT=wav
GAME_TTS_API_SAMPLE_RATE=24000
GAME_TTS_API_SPEED=1.0
GAME_TTS_API_VOLUME=50

# App
APP_LOG_LEVEL=info
APP_ENABLE_DIAGNOSTICS=false
