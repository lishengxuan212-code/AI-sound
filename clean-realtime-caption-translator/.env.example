# Local ASR
LOCAL_ASR_PROVIDER=sherpa_onnx
LOCAL_ASR_WS_URL=ws://127.0.0.1:8765/ws
LOCAL_ASR_MODEL_DIR=local-asr/models/sherpa-onnx-streaming-paraformer-bilingual-zh-en

# Local Translation
LOCAL_TRANSLATION_PROVIDER=
LOCAL_TRANSLATION_ENDPOINT=
LOCAL_TRANSLATION_MODEL_PATH=
LOCAL_TRANSLATION_MODEL_NAME=
LOCAL_TRANSLATION_SOURCE_LANG=en
LOCAL_TRANSLATION_TARGET_LANG=zh

# Qwen TTS
GAME_TTS_API_KEY=
DASHSCOPE_API_KEY=
GAME_TTS_API_MODEL=qwen-qwen-tts-latest
GAME_TTS_API_VOICE=
GAME_TTS_API_FORMAT=wav
GAME_TTS_API_SAMPLE_RATE=24000
GAME_TTS_API_SPEED=1.0
GAME_TTS_API_VOLUME=50

# App
APP_LOG_LEVEL=info
APP_ENABLE_DIAGNOSTICS=true
